# ==== NutricionAgent — configuración de ejemplo ====
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a Git.

# Ruta base datos del usuario (bóveda Markdown).
# Si se deja vacío, se usa <raíz del proyecto>/data/vault
NUTRICIONAGENT_DATA_DIR=

# Configuración de Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO